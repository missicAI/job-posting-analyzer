# Ollama local. Install Ollama and run: ollama pull llama3.2:3b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=

# Alternative: a provider supporting OpenAI-compatible chat + JSON schema.
# Set LLM_PROVIDER=compatible, LLM_BASE_URL=https://YOUR_PROVIDER/v1,
# LLM_MODEL=YOUR_MODEL, and LLM_API_KEY locally. Never commit .env.
